{
  "name": "cloudfleet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CloudFleet delivery management backend API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "test:coverage:backend": "c8 node --import tsx --test test/unit/*.test.ts",
    "test:coverage": "npm run test:coverage:backend && npm --prefix frontend run test:coverage",
    "test:e2e": "npm run local:e2e",
    "test:local": "npm run local:up && npm run test:unit && npm run test:integration && npm run test:e2e",
    "infra:typecheck": "npm --prefix infra run typecheck",
    "infra:synth": "npm --prefix infra run synth",
    "infra:deploy": "npm --prefix infra run deploy",
    "local:up": "docker compose up --build -d --wait",
    "local:dev": "npm run local:up && npm --prefix frontend run dev",
    "local:down": "docker compose down",
    "local:status": "docker compose ps -a",
    "local:logs": "docker compose logs -f backend local-init",
    "local:e2e": "npm run build && node dist/scripts/local-e2e.js",
    "local:reset": "docker compose down --volumes",
    "generate:vapid": "web-push generate-vapid-keys",
    "perf:50": "USERS=50 k6 run load/k6/cloudfleet-baseline.js",
    "perf:200": "USERS=200 k6 run load/k6/cloudfleet-baseline.js",
    "perf:500": "USERS=500 k6 run load/k6/cloudfleet-baseline.js",
    "perf:baseline": "K6_ENFORCE_THRESHOLDS=false npm run perf:50 && K6_ENFORCE_THRESHOLDS=false npm run perf:200 && K6_ENFORCE_THRESHOLDS=false npm run perf:500 && npm run perf:report",
    "perf:report": "node scripts/generate-baseline-report.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1117.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-emr-serverless": "^3.1126.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.1116.0",
    "@aws-sdk/client-sfn": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@smithy/types": "^4.18.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
