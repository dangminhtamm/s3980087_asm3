VITE_API_BASE_URL=http://localhost:3000
VITE_DRIVER_ID=DRV-018

# Use "disabled" for the local demo. Set "cognito" after `cdk deploy`.
VITE_AUTH_MODE=disabled
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=replace_with_cdk_output
VITE_COGNITO_CLIENT_ID=replace_with_cdk_output
VITE_COGNITO_DOMAIN=https://replace_with_cdk_output.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Docker Compose provisions real local DynamoDB and S3 data for this app.
# Switch back to true only when intentionally demonstrating without the API.
VITE_ENABLE_MOCK_FALLBACK=false
