{
  "name": "cloudfleet-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix ../frontend run build",
    "test": "npm run test:assertions",
    "test:assertions": "node --import tsx --test test/*.test.ts",
    "presynth": "npm --prefix ../frontend run build",
    "synth": "cdk synth --no-lookups --quiet",
    "prediff": "npm --prefix ../frontend run build",
    "diff": "cdk diff",
    "bootstrap": "cdk bootstrap",
    "predeploy": "npm --prefix ../frontend run build",
    "deploy": "cdk deploy --require-approval broadening",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1034.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
