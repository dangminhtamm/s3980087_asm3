# Runtime
NODE_ENV=development
PORT=3000
OBSERVABILITY_ENVIRONMENT=local
METRICS_SERVICE_NAME=cloudfleet-api
METRICS_NAMESPACE=CloudFleet/Observability

# Use "disabled" only for local development. ECS uses "cognito".
AUTH_MODE=disabled
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Comma-separated allowlist. Set this to the deployed frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS resource configuration (not credentials)
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE_NAME=cloudfleet-orders-dev
S3_DELIVERY_PROOF_BUCKET=cloudfleet-delivery-proofs-dev
S3_ANALYTICS_BUCKET=cloudfleet-analytics-dev

# Populated by CDK in ECS. Leave empty when using Docker Compose locally.
ANALYTICS_STATE_MACHINE_ARN=

# Optional local-service endpoints. Docker Compose sets these automatically.
# S3_PUBLIC_ENDPOINT must be reachable by the browser because it is embedded in
# presigned upload URLs; S3_ENDPOINT is used by the backend container itself.
# DYNAMODB_ENDPOINT=http://localhost:8000
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Populated automatically by CDK in ECS. Leave empty for local REST-only mode.
WEBSOCKET_PUBLIC_URL=
WEBSOCKET_MANAGEMENT_ENDPOINT=

# Public React origin used when issuing customer capability-token links.
TRACKING_BASE_URL=http://localhost:5173

# Manual address validation. The public Nominatim service is suitable only for
# low-volume local testing; use a managed/self-hosted provider in production.
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=CloudFleet/0.1
GEOCODING_MIN_INTERVAL_MS=1000

# Use "osrm" for road-network duration/distance/geometry. The default
# "straight-line" mode is deterministic and fully offline for tests.
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_ORIGIN_LAT=10.7769
ROUTING_ORIGIN_LNG=106.7009

# Lambda delivery notification (store the real secret in AWS Secrets Manager or
# encrypted Lambda environment variables; never commit it to source control).
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+10000000000

# Web Push. Generate a pair with `npm run generate:vapid`; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@cloudfleet.local

# Do not put long-lived AWS access keys in this file. Use AWS IAM Identity Center
# locally and an ECS task role in AWS; the SDK resolves them automatically.
