{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudFleet Proof of Delivery DynamoDB item",
  "description": "Proof metadata stored beside the order; the image bytes remain in the private S3 bucket.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PK": { "type": "string", "pattern": "^ORDER#.+$" },
    "SK": { "type": "string", "const": "PROOF#POD" },
    "orderId": { "type": "string", "format": "uuid" },
    "objectKey": {
      "type": "string",
      "pattern": "^proof-of-delivery/.+/(.+)\\.(jpg|png|webp)$"
    },
    "contentType": {
      "type": "string",
      "enum": ["image/jpeg", "image/png", "image/webp"]
    },
    "size": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "etag": { "type": "string", "minLength": 1 },
    "uploadedBy": {
      "type": "string",
      "description": "Cognito subject from the verified access token."
    },
    "uploadedAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "PK",
    "SK",
    "orderId",
    "objectKey",
    "contentType",
    "size",
    "etag",
    "uploadedBy",
    "uploadedAt"
  ],
  "x-access-patterns": [
    {
      "operation": "Get proof metadata for an order",
      "index": "PRIMARY",
      "keyCondition": "PK = ORDER#<orderId> AND SK = PROOF#POD"
    }
  ]
}
